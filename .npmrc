# Allow `pnpm add <pkg>` at the monorepo root without requiring `-w`.
# Set because `cloudflare/wrangler-action@v3` invokes `pnpm add wrangler@<version>`
# from the repo root, and pnpm v9+ defaults to erroring out
# (`ERR_PNPM_ADDING_TO_ROOT`) unless this is explicit. See deploy-web.yml
# build failure 2026-05-19 / commit 079cdb4 follow-up.
ignore-workspace-root-check=true
