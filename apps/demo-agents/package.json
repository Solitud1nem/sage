{
  "name": "@sage/demo-agents",
  "version": "0.0.1",
  "description": "Reference implementation — Orchestrator, Summarizer, Translator demo agents",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev:orchestrator": "node --env-file-if-exists=.env.orchestrator --import tsx src/orchestrator/server.ts",
    "dev:summarizer": "node --env-file-if-exists=.env.summarizer   --import tsx src/summarizer/agent.ts",
    "dev:translator": "node --env-file-if-exists=.env.translator   --import tsx src/translator/agent.ts",
    "dev:vision": "node --env-file-if-exists=.env.vision       --import tsx src/vision/agent.ts",
    "dev:sentiment": "node --env-file-if-exists=.env.sentiment    --import tsx src/sentiment/agent.ts",
    "dev:worker": "node --env-file-if-exists=.env.worker       --import tsx src/worker/server.ts",
    "bootstrap": "bash scripts/bootstrap-local.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sage/adapter-evm": "workspace:*",
    "@sage/core": "workspace:*",
    "fflate": "^0.8.3",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
