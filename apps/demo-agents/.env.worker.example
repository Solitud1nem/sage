# Generic worker (src/worker/server.ts) — local dev / Fly secrets reference.
# Copy to .env.worker for local runs:
#   node --env-file=.env.worker dist/worker/server.js

# REQUIRED. The worker refuses to boot without an explicit chain — no RPC-URL
# sniffing (GOTCHAS: a missing CHAIN once silently sent a prod deploy to
# Sepolia). mainnet | sepolia | arc
CHAIN=sepolia

# Optional — defaults to the chain's public RPC. Prod points at the Worker
# gateway proxy (with SAGE_BACKEND_KEY for the backend-path auth header).
# RPC_URL=https://sage-gateway.a-t-somnia.workers.dev/api/rpc
# SAGE_BACKEND_KEY=

# Which identities this process hosts (csv of ids from
# src/worker/identities.ts). Absent → all table entries.
WORKER_IDENTITIES=echo

# One key per hosted identity: <ID>_PRIVATE_KEY (id upper-cased, dashes →
# underscores). Fly: via `fly secrets set -c fly.workers.toml`, NEVER in git.
ECHO_PRIVATE_KEY=0x...

# OPENAI_API_KEY=            # needed once real LLM capabilities land (M12.1+)

PORT=3100
# WORKER_IDLE_GRACE_S=90     # 0 disables idle-exit (useful locally)
# WORKER_DRAIN_TIMEOUT_MS=110000
# WORKER_BOOT_SCAN_BACK=200
# WORKER_MIN_SCAN_INTERVAL_MS=3000
