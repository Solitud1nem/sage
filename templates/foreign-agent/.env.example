# ── Foreign agent — environment ────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env`.

# The agent's own EOA private key (0x-prefixed). This wallet:
#   - signs registerAgent / acceptTask / completeTask  → needs a little ETH for gas
#   - RECEIVES the task payment in USDC                 → no USDC needed up front
PRIVATE_KEY=0x...

# Chain: "mainnet" (Base) or "sepolia" (Base Sepolia).
CHAIN=mainnet

# RPC endpoint. A public Base RPC works; a dedicated/proxied one is better.
RPC_URL=https://mainnet.base.org

# The capability you offer + your price per task, in USDC base units (6 dp).
# Must match a capability name the Sage classifier resolves (e.g. "summarize",
# "translate", "sentiment-classify", "vision-describe"). Undercut the incumbents
# to get picked — the classifier selects the cheapest active agent. 1000 = 0.001 USDC.
CAPABILITY=summarize
PRICE_UNITS=500

# A public endpoint describing your agent (shown in the registry). Any URL.
ENDPOINT=https://example.com/my-sage-agent

# Health-check port.
PORT=3010

# Optional: if set, the example handler calls OpenAI gpt-4o-mini. If unset, it
# falls back to a trivial deterministic transform. Replace `src/handler.ts`
# with your real logic.
OPENAI_API_KEY=

# ── Safety guards (sensible defaults; tune for your agent) ──────────────────
# The runtime accepts ANY task routed to your address — including ones created
# outside the Sage classifier with arbitrary economics. These bound what you'll
# take on so a hostile client can't make you burn gas/LLM spend for nothing.

# Refuse tasks paying less than your registered price. Default: PRICE_UNITS.
# Set lower only if you deliberately accept below-list work.
MIN_TASK_UNITS=

# Refuse tasks whose deadline is closer than this many seconds — you need time
# to accept + execute + complete before it expires (a missed deadline = no pay).
MIN_DEADLINE_MARGIN_S=120

# Cap the material handed to your handler (chars). Protects against a client
# stuffing megabytes into specUri to inflate your LLM bill. 0 = no cap.
MAX_MATERIAL_CHARS=100000

# On boot, scan this many tasks back from the chain head so jobs created while
# you were offline (deploys, crashes) aren't black-holed. 0 = head-only.
BOOT_SCAN_BACK=200

# How many times to retry the handler on a transient failure (OpenAI 5xx/429)
# before giving up on a task. 0 = no retry.
HANDLER_RETRIES=2
