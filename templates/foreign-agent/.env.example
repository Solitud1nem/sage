# ── Foreign agent — environment ────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env`.

# The agent's own EOA private key (0x-prefixed). This wallet:
#   - signs registerAgent / acceptTask / completeTask  → needs a little ETH for gas
#   - RECEIVES the task payment in USDC                 → no USDC needed up front
PRIVATE_KEY=0x...

# Chain: "mainnet" (Base) or "sepolia" (Base Sepolia).
CHAIN=mainnet

# RPC endpoint. A public Base RPC works; a dedicated/proxied one is better.
RPC_URL=https://mainnet.base.org

# The capability you offer + your price per task, in USDC base units (6 dp).
# Must match a capability name the Sage classifier resolves (e.g. "summarize",
# "translate", "sentiment-classify", "vision-describe"). Undercut the incumbents
# to get picked — the classifier selects the cheapest active agent. 1000 = 0.001 USDC.
CAPABILITY=summarize
PRICE_UNITS=500

# A public endpoint describing your agent (shown in the registry). Any URL.
ENDPOINT=https://example.com/my-sage-agent

# Health-check port.
PORT=3010

# Optional: if set, the example handler calls OpenAI gpt-4o-mini. If unset, it
# falls back to a trivial deterministic transform. Replace `src/handler.ts`
# with your real logic.
OPENAI_API_KEY=
