# Deploy configuration — copy to .env and fill in values

# Deployer private key (funded with ETH on target chain)
DEPLOYER_PRIVATE_KEY=0x...

# USDC address on target chain
# Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base Mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Owner address for AgentRegistry emergency pause
REGISTRY_OWNER=0x...

# RPC URLs
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_MAINNET_RPC=https://mainnet.base.org

# Basescan API key (for contract verification)
BASESCAN_API_KEY=...

# Post-deploy: fill in after deployment
REGISTRY_ADDRESS=
ESCROW_ADDRESS=

# ── TaskEscrowV2 deploy (ADR-0017 / M11.1) ─────────────────────────────
# Owner EOA — holds setArbiter authority. Per session 2026-06-08 decision,
# launches as the same EOA as the deployer / sponsor. Migrate to a Safe
# via transferOwnership later (Ownable2Step two-step).
INITIAL_OWNER=0x...

# Arbiter EOA — calls resolveDispute. Per launch posture, same as INITIAL_OWNER
# during early operation. Rotate to a dedicated key via setArbiter once the
# council mechanism (M11.4) needs key isolation.
INITIAL_ARBITER=0x...

# Post-deploy: fill in after V2 deployment
ESCROW_V2_ADDRESS=

# ── AgentRegistryV2 deploy (M11.2) ─────────────────────────────────────
# Reuses REGISTRY_OWNER from v1 deploy section above — same EOA holds
# emergency-pause authority for both v1 and v2 on Sage's launch posture.
# Post-deploy: fill in after V2 deployment
REGISTRY_V2_ADDRESS=
