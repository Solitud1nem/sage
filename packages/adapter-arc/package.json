{
  "name": "@sage/adapter-arc",
  "version": "0.0.1",
  "description": "Arc adapter for Sage — native ERC-8183 Job + ERC-8004 Identity wrapper. Status: scaffold, pending Arc testnet RPC + ERC standards stability. See ADR-0014.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sage/core": "workspace:*"
  },
  "peerDependencies": {
    "viem": ">=2.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "viem": "^2.0.0",
    "vitest": "^3.0.0"
  }
}
